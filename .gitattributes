* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# WSL/Linux 执行的源码与配置统一保留 LF。
*.py text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
requirements.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf

# Windows 原生脚本使用 CRLF；二进制资产不做换行转换。
*.ps1 text eol=crlf
*.xlsx binary
*.png binary
*.exe binary
