# 正常不要手填：运行 ./scripts/bootstrap.sh 自动生成 .env。
HOST_UID=1000
HOST_GID=1000

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=benchmark
MYSQL_USER=bench
MYSQL_PASSWORD=
BENCH_DB_PORT=3307
BENCH_WEB_PORT=8000

SESSION_SECRET=
NEWAPI_PORT=3000
NEWAPI_USER_ID=1
# NewAPI 首次初始化并生成系统访问令牌后填入；为空时跳过逐轮日志采集和后台对账。
NEWAPI_ACCESS_TOKEN=
# 可选：限定被测应用的 NewAPI 令牌名，减少其它流量干扰。
NEWAPI_TOKEN_NAME=

# WSL 路径：挂载整个 %APPDATA%\yonwork 目录，Runner 会动态读取端口和 Token。
YONWORK_DATA_DIR=/mnt/c/Users/<用户名>/AppData/Roaming/yonwork
# Windows 应用能够读取的 fixture 路径。
# 反斜杠写**单个**：compose 读 env file 时不做转义处理，`\\` 会原样进容器，
# 变成 YonWork 打不开的路径，而且会被断言记成产品 Fail 而不是配置问题。
YONWORK_XIYOUJI_PATH=C:\Users\<用户名>\Documents\yonwork-benchmark\西游记[lunarora.com].txt
