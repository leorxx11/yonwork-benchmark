# 正常不要手填：运行 ./scripts/bootstrap.sh 自动生成 .env。
HOST_UID=1000
HOST_GID=1000

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=benchmark
MYSQL_USER=bench
MYSQL_PASSWORD=
BENCH_DB_PORT=3307
BENCH_WEB_PORT=8000

SESSION_SECRET=
NEWAPI_PORT=3000
# NewAPI 的连接池会被污染，表现为「突然挂几分钟」，重启即恢复。
# 排查过程和证据见 docs/newapi-stall.md。留空用 compose 里的默认值。
NEWAPI_IDLE_CONN_TIMEOUT=
NEWAPI_MAX_IDLE_CONNS=
NEWAPI_CONNECT_TIMEOUT=
# 挂住比失败更糟：挂几分钟会被记成产品 Timeout，那是假缺陷。
NEWAPI_RELAY_TIMEOUT=
NEWAPI_STREAMING_TIMEOUT=
NEWAPI_USER_ID=1
# NewAPI 首次初始化并生成系统访问令牌后填入；为空时跳过逐轮日志采集和后台对账。
NEWAPI_ACCESS_TOKEN=
# 可选：限定被测应用的 NewAPI 令牌名，减少其它流量干扰。
NEWAPI_TOKEN_NAME=

# WSL 路径：挂载整个 %APPDATA%\yonwork 目录，Runner 会动态读取端口和 Token。
YONWORK_DATA_DIR=/mnt/c/Users/<用户名>/AppData/Roaming/yonwork
# Windows 应用能够读取的 fixture 路径。
# 反斜杠写**单个**：compose 读 env file 时不做转义处理，`\\` 会原样进容器，
# 变成 YonWork 打不开的路径，而且会被断言记成产品 Fail 而不是配置问题。
YONWORK_XIYOUJI_PATH=C:\Users\<用户名>\Documents\yonwork-benchmark\西游记[lunarora.com].txt

# --- 逐请求模型调用采集代理（默认关闭）---
# 开了之后链路变成 产品 → 采集代理 → NewAPI → 上游模型，
# NewAPI 对账从时间窗匹配换成精确关联。详见 docs/model-request-ledger.md。
#
# ⚠️ 开关只管我们这一侧。**产品配置里的 baseUrl 也得手动指过来**
#    （YonWork 的 provider、WorkBuddy 的 models.json），否则开了也没有请求经过。
#    回退同理：设回 0 之后必须把产品的 baseUrl 改回直连 NewAPI，
#    不然产品会打到一个没人监听的端口，每一轮都失败。
BENCH_COLLECTOR_ENABLED=0
# auto（默认）/ service / embedded。
# service = 用常驻的 collector 容器（docker compose up -d collector）。
# 常驻的好处：**不跑批时入口也活着**，在产品界面里手动选这个模型也能用；
# 跟着跑批起停的话，不跑批时那个模型是死的，一用就报「模型服务暂时不可用」。
# auto = 常驻服务在就用它，不在就跑批自己起一个（纯 CLI 机器照常能跑）。
BENCH_COLLECTOR_MODE=auto
# 固定端口。产品配置里存的是 URL，端口每次变就得重配产品。
BENCH_COLLECTOR_PORT=3312
BENCH_COLLECTOR_BIND=127.0.0.1
# 留空则跟随 NEWAPI_BASE_URL。
BENCH_COLLECTOR_UPSTREAM=
# 代理用它调 NewAPI：填产品原来直连时用的那个 NewAPI 令牌。
BENCH_COLLECTOR_UPSTREAM_KEY=
# 产品配置里当 apiKey 填的值，用来挡掉同端口上的其它流量。
# 自己生成一个：python -c "import secrets;print(secrets.token_hex(24))"
BENCH_COLLECTOR_CLIENT_TOKEN=
# 账本落在 <这个目录>/<batch_id>/model-requests.jsonl，同 results/ 不进版本库。
BENCH_COLLECTOR_LEDGER_DIR=results
BENCH_COLLECTOR_TIMEOUT_SECONDS=300

# --- WorkBuddy（只有宿主机 Worker 用得上，容器 Worker 起不了 Windows 进程）---
# 两个都可以留空：默认去 /mnt/d/WorkBuddy 找安装目录，
# 配置目录在 /mnt/c/Users/*/.workbuddy 里找且**必须唯一**——
# 有多个候选时驱动会报错而不是挑一个，挑错了会读到另一个账号的产品配置。
BENCH_WORKBUDDY_HOME=
BENCH_WORKBUDDY_CONFIG_DIR=
